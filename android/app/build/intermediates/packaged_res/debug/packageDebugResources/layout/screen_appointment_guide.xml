<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:fillViewport="true"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">
        <Button
            android:id="@+id/guideBack"
            style="@style/TextAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="‹  Back" />
        <include layout="@layout/view_brand_header" />
        <TextView
            style="@style/Heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Appointment checklist" />
        <TextView
            style="@style/BodyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Use this guide to prepare before visiting an office." />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="17dp">
            <CheckBox
                android:id="@+id/checkOriginalId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/green"
                android:text="Bring your original South African ID"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
            <CheckBox
                android:id="@+id/checkProof"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/green"
                android:text="Bring proof of your appointment"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
            <CheckBox
                android:id="@+id/checkDocuments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/green"
                android:text="Check the documents for your service"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
            <CheckBox
                android:id="@+id/checkArrive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/green"
                android:text="Plan to arrive 15 minutes early"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>
        <Button
            android:id="@+id/guideStartApplication"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Start a service application" />
        <Button
            android:id="@+id/guideAppointments"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="View appointments" />
    </LinearLayout>
</ScrollView>
