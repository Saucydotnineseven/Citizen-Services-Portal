<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="danger">#B5473C</color>
    <color name="forest">#0D4A36</color>
    <color name="forest_dark">#083A2A</color>
    <color name="gold">#D5AA55</color>
    <color name="green">#18734F</color>
    <color name="line">#E2E7E1</color>
    <color name="page">#F6F5F0</color>
    <color name="soft_gold">#F8F0DF</color>
    <color name="soft_green">#EAF3ED</color>
    <color name="surface">#FFFFFF</color>
    <color name="text_primary">#17231D</color>
    <color name="text_secondary">#65726A</color>
    <string name="app_name">Home Affairs Citizen</string>
    <string name="country_name">REPUBLIC OF SOUTH AFRICA</string>
    <string name="demo_note">Demo experience · Your details are not sent or stored</string>
    <string name="department_name">DEPARTMENT OF HOME AFFAIRS</string>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/green</item>
        <item name="android:statusBarColor">@color/forest_dark</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/page</item>
    </style>
    <style name="BodyText">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="FieldLabel">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Heading">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">27sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="PrimaryButton">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/surface</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="SecondaryButton">
        <item name="android:background">@drawable/bg_secondary_button</item>
        <item name="android:textColor">@color/forest</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="SectionHeading">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAction">
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:textColor">@color/green</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>